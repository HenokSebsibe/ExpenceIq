    <color name="bg_light">@color/luxury_light_bg</color>
    <color name="bg_light_premium">@color/luxury_light_bg</color>
    <color name="black">#FF000000</color>
    <color name="card_dark_premium">@color/night_card</color>
    <color name="card_light">@color/luxury_card</color>
    <color name="colorAccent">@color/royal_gold</color>
    <color name="colorPrimary">@color/royal_blue</color>
    <color name="colorPrimaryDark">#001A4D</color>
    <color name="deep_blue">@color/royal_blue</color>
    <color name="expense_grad_end">#FF7675</color>
    <color name="expense_grad_start">#E74C3C</color>
    <color name="expense_red">#E74C3C</color>
    <color name="gold">@color/night_gold</color>
    <color name="gold_accent">@color/night_gold</color>
    <color name="grad_end">#F1E5AC</color>
    <color name="grad_start">@color/night_gold</color>
    <color name="ic_launcher_background">#FFFFFF</color>
    <color name="income_grad_end">#55E6C1</color>
    <color name="income_grad_start">#2ECC71</color>
    <color name="income_green">#2ECC71</color>
    <color name="luxury_card">#FFFFFF</color>
    <color name="luxury_emerald">@color/income_green</color>
    <color name="luxury_gold">@color/night_gold</color>
    <color name="luxury_light_bg">#F5F5F5</color>
    <color name="luxury_matte_black">@color/night_bg_matte</color>
    <color name="luxury_pearl">@color/luxury_light_bg</color>
    <color name="luxury_text_primary">@color/text_primary_light</color>
    <color name="luxury_text_secondary">@color/text_secondary_light</color>
    <color name="night_bg_matte">#0D0D0D</color>
    <color name="night_bg_secondary">#161616</color>
    <color name="night_card">#1E1E1E</color>
    <color name="night_card_elevated">#252525</color>
    <color name="night_error">#CF6679</color>
    <color name="night_gold">#D4AF37</color>
    <color name="night_platinum">#B0B0B0</color>
    <color name="night_text_hint">#8A8A8A</color>
    <color name="night_text_primary">#FFFFFF</color>
    <color name="night_text_secondary">#D0D0D0</color>
    <color name="primary_dark_light">#001A4D</color>
    <color name="primary_dark_variant">#000000</color>
    <color name="primary_light">@color/royal_blue</color>
    <color name="royal_blue">#002366</color>
    <color name="royal_gold">#D4AF37</color>
    <color name="text_primary_dark">@color/night_text_primary</color>
    <color name="text_primary_light">#1A1A1A</color>
    <color name="text_secondary_dark">@color/night_text_secondary</color>
    <color name="text_secondary_light">#757575</color>
    <color name="white">#FFFFFFFF</color>
    <string name="app_name">Smart Expense Tracker</string>
    <style name="PremiumBottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="backgroundTint">@color/white</item>
        <item name="itemIconTint">@color/royal_blue</item>
        <item name="itemTextColor">@color/text_secondary_light</item>
    </style>
    <style name="PremiumButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/royal_blue</item>
    </style>
    <style name="PremiumCardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">4dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="cardBackgroundColor">@color/white</item>
    </style>
    <style name="PremiumTextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/royal_blue</item>
        <item name="hintTextColor">@color/royal_blue</item>
    </style>
    <style name="Theme.SmartExpenseTracker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        
        <item name="colorPrimary">@color/royal_blue</item>
        <item name="colorPrimaryVariant">@color/primary_dark_light</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <item name="colorSecondary">@color/royal_gold</item>
        <item name="colorOnSecondary">@color/white</item>

        
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:windowLightStatusBar" ns1:targetApi="m">true</item>

        
        <item name="android:windowBackground">@color/luxury_light_bg</item>
        <item name="colorSurface">@color/white</item>

        
        <item name="android:textColorPrimary">@color/text_primary_light</item>
        <item name="android:textColorSecondary">@color/text_secondary_light</item>

        
        <item name="cardViewStyle">@style/PremiumCardView</item>
        <item name="textInputStyle">@style/PremiumTextInputLayout</item>
        <item name="materialButtonStyle">@style/PremiumButton</item>
        <item name="bottomNavigationStyle">@style/PremiumBottomNav</item>
    </style>
</resources>