<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Premium Night Mode Theme. -->
    <style name="Theme.SmartExpenseTracker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/night_gold</item>
        <item name="colorPrimaryVariant">@color/black</item>
        <item name="colorOnPrimary">@color/black</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/night_gold</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Status bar & Navigation bar color. -->
        <item name="android:statusBarColor">@color/night_bg_matte</item>
        <item name="android:navigationBarColor">@color/night_bg_matte</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Background & Surface -->
        <item name="android:windowBackground">@color/night_bg_matte</item>
        <item name="colorSurface">@color/night_card</item>
        <item name="colorError">@color/night_error</item>

        <!-- Text Colors -->
        <item name="android:textColorPrimary">@color/night_text_primary</item>
        <item name="android:textColorSecondary">@color/night_text_secondary</item>
        <item name="android:textColorHint">@color/night_text_hint</item>

        <!-- Component Styles -->
        <item name="cardViewStyle">@style/PremiumCardView.Dark</item>
        <item name="textInputStyle">@style/PremiumTextInputLayout.Dark</item>
        <item name="materialButtonStyle">@style/PremiumButton.Dark</item>
        <item name="bottomNavigationStyle">@style/PremiumBottomNav.Dark</item>
    </style>

    <style name="PremiumCardView.Dark" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="cardBackgroundColor">@color/night_card</item>
        <item name="strokeColor">#1AFFFFFF</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="PremiumTextInputLayout.Dark" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/night_gold</item>
        <item name="hintTextColor">@color/night_gold</item>
        <item name="boxBackgroundColor">@color/night_bg_secondary</item>
        <item name="android:textColorHint">@color/night_text_hint</item>
    </style>

    <style name="PremiumButton.Dark" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/night_gold</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="PremiumBottomNav.Dark" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="backgroundTint">@color/night_bg_matte</item>
        <item name="itemIconTint">@color/night_gold</item>
        <item name="itemTextColor">@color/night_text_secondary</item>
    </style>
</resources>
